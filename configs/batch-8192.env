# Batch profile — long-context jobs 512K–1M, EXCLUSIVE operation.
# No concurrent agent traffic: a single large prefill saturates the system
# and starves everything else (RESULTS §3).

MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=6                 # cudagraph = MAX_NUM_SEQS x (MTP_NUM_TOKENS+1) = 36
MTP_NUM_TOKENS=5               # k <= 5 or a multiple of 5. k=7 is rejected at boot.
GPU_MEMORY_UTILIZATION=0.78    # 0.80 boots but dies under traffic (recipe issue #8)
MAX_MODEL_LEN=1048576

# Practical limits from the measurements:
#   at most ~4 concurrent generations (saturation at N=4)
#   normal context <= 128K
#   dynamic prompt fields LAST — see RESULTS §5
#   the gateway must filter repetition_penalty (crashes the DSpark path)
#   presence_penalty / frequency_penalty verified safe

# --- fill in per installation ---
WORKER_HOST=<worker-roce-ip>
MASTER_ADDR=<head-roce-ip>
VLLM_HOST_IP=<head-roce-ip>
WORKER_VLLM_HOST_IP=<worker-roce-ip>
NCCL_IB_HCA=<head-roce-device>
NCCL_SOCKET_IFNAME=<head-iface>
# Asymmetric cabling? The worker needs ITS OWN device names — the recipe's start
# script otherwise copies the head's values to both nodes.
WORKER_NCCL_IB_HCA=<worker-roce-device>
WORKER_NCCL_SOCKET_IFNAME=<worker-iface>
