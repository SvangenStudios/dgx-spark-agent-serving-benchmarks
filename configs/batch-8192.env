# Batchprofil — långkontextjobb 512K–1M, EXKLUSIV körning.
# Ingen samtidig agenttrafik: en enda stor prefill mättar systemet
# och svälter all annan trafik (§3).

MAX_NUM_BATCHED_TOKENS=8192
MAX_NUM_SEQS=6                 # cudagraph = MAX_NUM_SEQS × (MTP_NUM_TOKENS+1) = 36
MTP_NUM_TOKENS=5               # k ≤ 5 eller multipel av 5. k=7 avvisas vid boot.
GPU_MEMORY_UTILIZATION=0.78    # 0.80 bootar men dör under trafik (recept-issue #8)
MAX_MODEL_LEN=1048576

# Praktiska gränser ur mätningarna:
#   högst ~4 samtidiga genereringar (mättnad vid N=4)
#   normal kontext ≤128K
#   dynamiska promptfält SIST — se §5
#   gateway måste filtrera repetition_penalty
#   presence_penalty / frequency_penalty är verifierat säkra

# --- fylls i per installation ---
WORKER_HOST=<worker-roce-ip>
MASTER_ADDR=<head-roce-ip>
VLLM_HOST_IP=<head-roce-ip>
WORKER_VLLM_HOST_IP=<worker-roce-ip>
NCCL_IB_HCA=<head-roce-device>
NCCL_SOCKET_IFNAME=<head-iface>
# Asymmetrisk kabling? Workern behöver SINA devicenamn — receptets startskript
# kopierar annars headens värden till båda noderna.
WORKER_NCCL_IB_HCA=<worker-roce-device>
WORKER_NCCL_SOCKET_IFNAME=<worker-iface>
